<UserControl x:Class="TableManager.UI.Views.ExportBackupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:vm="clr-namespace:TableManager.UI.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="600" d:DesignWidth="800">
    <UserControl.DataContext>
        <vm:ExportBackupViewModel />
    </UserControl.DataContext>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
            <TextBlock Text="数据导出与备份" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="数据导出" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Margin="0,0,10,0">
                            <Button Command="{Binding ExportProductsCommand}" Content="导出商品数据" 
                                    Height="40" Margin="0,5" Padding="10"/>
                            <Button Command="{Binding ExportCustomersCommand}" Content="导出客户数据" 
                                    Height="40" Margin="0,5" Padding="10"/>
                        </StackPanel>
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <Button Command="{Binding ExportOrdersCommand}" Content="导出订单数据" 
                                    Height="40" Margin="0,5" Padding="10"/>
                            <Button Command="{Binding ExportStockRecordsCommand}" Content="导出库存记录" 
                                    Height="40" Margin="0,5" Padding="10"/>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="数据库备份与恢复" FontSize="18" FontWeight="Bold" Margin="0,0,0,15"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                        <Button Command="{Binding BackupDatabaseCommand}" Content="备份数据库" 
                                Height="40" Margin="0,0,10,0" Padding="10"/>
                        <Button Command="{Binding BackupDatabaseCompressedCommand}" Content="压缩备份" 
                                Height="40" Margin="0,0,10,0" Padding="10"/>
                        <TextBlock Text="数据库大小: " VerticalAlignment="Center"/>
                        <TextBlock Text="{Binding DatabaseSize}" FontWeight="Bold" VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="备份文件列表" FontWeight="Bold" Margin="0,10,0,5"/>
                    <ListBox ItemsSource="{Binding BackupFiles}" 
                             SelectedItem="{Binding SelectedBackupFile}"
                             Height="150" Margin="0,0,0,10"/>
                    <StackPanel Orientation="Horizontal">
                        <Button Command="{Binding RestoreDatabaseCommand}" Content="恢复选中备份" 
                                Height="35" Margin="0,0,10,0" Padding="10"/>
                        <Button Command="{Binding DeleteBackupCommand}" Content="删除选中备份" 
                                Height="35" Margin="0,0,10,0" Padding="10"/>
                        <Button Command="{Binding LoadBackupFilesCommand}" Content="刷新列表" 
                                Height="35" Padding="10"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <Border Background="#FFF0F0F0" CornerRadius="8" Padding="15">
                <StackPanel>
                    <TextBlock Text="状态信息" FontWeight="Bold" Margin="0,0,0,5"/>
                    <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap"/>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
