<UserControl x:Class="TableManager.UI.Views.OrdersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:TableManager.UI.ViewModels"
             xmlns:models="clr-namespace:TableManager.DAL.Models;assembly=TableManager.DAL"
             xmlns:converters="clr-namespace:TableManager.UI.Converters"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800"
             Loaded="UserControl_Loaded">
    <UserControl.DataContext>
        <vm:OrdersViewModel x:Name="ViewModel"/>
    </UserControl.DataContext>
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:OrderStatusConverter x:Key="OrderStatusConverter"/>
    </UserControl.Resources>
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="White" CornerRadius="8" Padding="15" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="订单管理" FontSize="20" FontWeight="Bold" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Content="刷新" Command="{Binding LoadDataCommand}" Padding="15,8" Margin="5"/>
                    <Button Content="新建订单" Command="{Binding OpenCreateOrderDialogCommand}" Padding="15,8" Margin="5" Background="#3498DB" Foreground="White"/>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="15">
            <DataGrid x:Name="OrdersGrid" ItemsSource="{Binding Orders}" SelectedItem="{Binding SelectedOrder}" 
                      AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single"
                      MouseDoubleClick="OrdersGrid_MouseDoubleClick">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="订单号" Binding="{Binding OrderNumber}" Width="*"/>
                    <DataGridTextColumn Header="客户ID" Binding="{Binding CustomerId}" Width="*"/>
                    <DataGridTextColumn Header="总金额" Binding="{Binding TotalAmount, StringFormat=C}" Width="*"/>
                    <DataGridTextColumn Header="状态" Binding="{Binding Status, Converter={StaticResource OrderStatusConverter}}" Width="*"/>
                    <DataGridTextColumn Header="订单日期" Binding="{Binding OrderDate, StringFormat=yyyy-MM-dd HH:mm}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#00000080" 
                Visibility="{Binding IsCreateOrderDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="700" Height="500" Background="White" CornerRadius="8" Padding="20" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <TextBlock Grid.Row="0" Text="新建订单" FontSize="20" FontWeight="Bold" Margin="0,0,0,15"/>
                    
                    <Grid Grid.Row="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>
                        
                        <Grid Grid.Row="0" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" Margin="0,0,5,0">
                                <TextBlock Text="选择客户" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <ComboBox ItemsSource="{Binding Customers}" SelectedItem="{Binding SelectedCustomer}" 
                                          DisplayMemberPath="Name" Height="30"/>
                            </StackPanel>
                            <StackPanel Grid.Column="1" Margin="5,0,0,0">
                                <TextBlock Text="备注" FontWeight="SemiBold" Margin="0,0,0,5"/>
                                <TextBox Text="{Binding OrderNotes}" Height="30"/>
                            </StackPanel>
                        </Grid>
                        
                        <Grid Grid.Row="1" Margin="0,10,0,10">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                            </Grid.RowDefinitions>
                            
                            <Grid Grid.Row="0" Margin="0,0,0,5">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>
                                <ComboBox Grid.Column="0" ItemsSource="{Binding Products}" SelectedItem="{Binding SelectedProduct}" 
                                          DisplayMemberPath="Name" Height="30"/>
                                <Button Grid.Column="1" Content="添加商品" Command="{Binding AddProductToOrderCommand}" 
                                        Padding="10,5" Margin="5,0,0,0"/>
                            </Grid>
                            
                            <DataGrid Grid.Row="1" ItemsSource="{Binding CurrentOrderItems}" AutoGenerateColumns="False" 
                                      CanUserAddRows="False" CanUserDeleteRows="False">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品名称" Binding="{Binding ProductName}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=C}" Width="*" IsReadOnly="True"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="*"/>
                                    <DataGridTextColumn Header="小计" Binding="{Binding Subtotal, StringFormat=C}" Width="*" IsReadOnly="True"/>
                                    <DataGridTemplateColumn Header="操作" Width="*">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Content="删除" Command="{Binding DataContext.RemoveItemFromOrderCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding}" Padding="8,3"/>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                        
                        <TextBlock Grid.Row="2" Text="{Binding GetOrderTotal(), StringFormat='总计: {0:C}'}" 
                                   FontSize="16" FontWeight="Bold" HorizontalAlignment="Right"/>
                    </Grid>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="取消" Command="{Binding CloseCreateOrderDialogCommand}" Padding="20,8" Margin="5"/>
                        <Button Content="创建订单" Command="{Binding CreateOrderCommand}" Padding="20,8" Margin="5" 
                                Background="#3498DB" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#00000080" 
                Visibility="{Binding IsOrderDetailDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Width="650" Height="500" Background="White" CornerRadius="8" Padding="20" 
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>
                    
                    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,15">
                        <TextBlock Text="订单详情" FontSize="20" FontWeight="Bold"/>
                        <TextBlock Text="{Binding SelectedOrderDetail.Order.OrderNumber}" FontSize="20" FontWeight="Bold" 
                                   Margin="10,0,0,0" Foreground="#3498DB"/>
                    </StackPanel>
                    
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Border Background="#F8F9FA" Padding="15" CornerRadius="5" Margin="0,0,0,10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="客户信息" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Customer.Name}" FontSize="14"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Customer.Phone}" FontSize="12" Foreground="#666"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Customer.Email}" FontSize="12" Foreground="#666"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1">
                                        <TextBlock Text="订单信息" FontWeight="Bold" Margin="0,0,0,8"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.OrderDate, StringFormat='订单日期: yyyy-MM-dd HH:mm'}" FontSize="12"/>
                                        <TextBlock Text="{Binding SelectedOrderDetail.Order.Status, Converter={StaticResource OrderStatusConverter}}" 
                                                   FontSize="14" FontWeight="Bold"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                            
                            <TextBlock Text="商品明细" FontWeight="Bold" Margin="0,0,0,8"/>
                            <DataGrid ItemsSource="{Binding SelectedOrderDetail.Items}" AutoGenerateColumns="False" 
                                      IsReadOnly="True" Height="180">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="商品ID" Binding="{Binding ProductId}" Width="*"/>
                                    <DataGridTextColumn Header="数量" Binding="{Binding Quantity}" Width="*"/>
                                    <DataGridTextColumn Header="单价" Binding="{Binding UnitPrice, StringFormat=C}" Width="*"/>
                                    <DataGridTextColumn Header="小计" Binding="{Binding Subtotal, StringFormat=C}" Width="*"/>
                                </DataGrid.Columns>
                            </DataGrid>
                            
                            <TextBlock Text="{Binding SelectedOrderDetail.Order.TotalAmount, StringFormat='订单总额: {0:C}'}" 
                                       FontSize="16" FontWeight="Bold" HorizontalAlignment="Right" Margin="0,10,0,0"/>
                            
                            <TextBlock Text="{Binding SelectedOrderDetail.Order.Notes, StringFormat='备注: {0}'}" 
                                       FontSize="12" Foreground="#666" Margin="0,10,0,0"/>
                        </StackPanel>
                    </ScrollViewer>
                    
                    <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,15,0,0">
                        <Button Content="关闭" Command="{Binding CloseOrderDetailDialogCommand}" Padding="20,8" Margin="5"/>
                        <Button Content="发货" Command="{Binding UpdateOrderStatusCommand}" CommandParameter="{x:Static models:OrderStatus.Shipped}" 
                                Padding="20,8" Margin="5"/>
                        <Button Content="完成" Command="{Binding UpdateOrderStatusCommand}" CommandParameter="{x:Static models:OrderStatus.Completed}" 
                                Padding="20,8" Margin="5" Background="#2ECC71" Foreground="White"/>
                        <Button Content="取消订单" Command="{Binding UpdateOrderStatusCommand}" CommandParameter="{x:Static models:OrderStatus.Cancelled}" 
                                Padding="20,8" Margin="5" Background="#E74C3C" Foreground="White"/>
                    </StackPanel>
                </Grid>
            </Border>
        </Border>

        <Border Grid.Row="0" Grid.RowSpan="2" Background="#E74C3C" CornerRadius="5" Padding="15" 
                HorizontalAlignment="Center" VerticalAlignment="Top" Margin="20"
                Visibility="{Binding ShowErrorMessage, Converter={StaticResource BoolToVisibilityConverter}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="White" FontSize="14"/>
        </Border>
    </Grid>
</UserControl>
