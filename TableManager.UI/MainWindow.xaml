<Window x:Class="TableManager.UI.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TableManager.UI"
        xmlns:vm="clr-namespace:TableManager.UI.ViewModels"
        xmlns:views="clr-namespace:TableManager.UI.Views"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="TableManager - 企业级ERP/CRM管理系统" Height="600" Width="1000"
        WindowStartupLocation="CenterScreen">
    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <DataTemplate x:Key="DashboardTemplate">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Margin="20">
                    <TextBlock Text="仪表盘" FontSize="24" FontWeight="Bold" Margin="0,0,0,20"/>
                    
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        
                        <Border Grid.Column="0" Background="White" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="商品数量" FontSize="14" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding ProductCount}" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="1" Background="White" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="客户数量" FontSize="14" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding CustomerCount}" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                        
                        <Border Grid.Column="2" Background="White" CornerRadius="8" Padding="15" Margin="5">
                            <StackPanel>
                                <TextBlock Text="订单数量" FontSize="14" Foreground="#7F8C8D"/>
                                <TextBlock Text="{Binding OrderCount}" FontSize="32" FontWeight="Bold"/>
                            </StackPanel>
                        </Border>
                    </Grid>
                    
                    <Border Background="White" CornerRadius="8" Padding="20" Margin="0,20,0,0">
                        <TextBlock Text="欢迎使用 TableManager 企业级ERP/CRM管理系统！&#x0a;请从左侧导航选择功能模块。" 
                                   TextWrapping="Wrap" FontSize="16"/>
                    </Border>
                </StackPanel>
            </ScrollViewer>
        </DataTemplate>
    </Window.Resources>
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="200"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Background="#2C3E50">
            <StackPanel Margin="10">
                <TextBlock Text="TableManager" FontSize="20" FontWeight="Bold" 
                           Foreground="White" Margin="0,0,0,20"/>
                
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Dashboard"
                        Content="仪表盘" Margin="0,5" Padding="10" HorizontalAlignment="Stretch"/>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Products"
                        Content="商品管理" Margin="0,5" Padding="10" HorizontalAlignment="Stretch"/>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Customers"
                        Content="客户管理" Margin="0,5" Padding="10" HorizontalAlignment="Stretch"/>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Orders"
                        Content="订单管理" Margin="0,5" Padding="10" HorizontalAlignment="Stretch"/>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="Stock"
                        Content="库存管理" Margin="0,5" Padding="10" HorizontalAlignment="Stretch"/>
                <Button Command="{Binding NavigateToCommand}" CommandParameter="ExportBackup"
                        Content="数据导出与备份" Margin="0,5" Padding="10" HorizontalAlignment="Stretch"/>
            </StackPanel>
        </Border>

        <Border Grid.Column="1" Background="#ECF0F1">
            <ContentControl Content="{Binding CurrentView}">
                <ContentControl.Resources>
                    <DataTemplate DataType="{x:Type sys:String}">
                        <StackPanel>
                            <TextBlock Text="即将推出..." FontSize="24" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </StackPanel>
                    </DataTemplate>
                </ContentControl.Resources>
                <ContentControl.Style>
                    <Style TargetType="ContentControl">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Dashboard">
                                <Setter Property="ContentTemplate" Value="{StaticResource DashboardTemplate}"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Products">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:ProductsView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Customers">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:CustomersView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Orders">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:OrdersView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="Stock">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:StockView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding CurrentView}" Value="ExportBackup">
                                <Setter Property="ContentTemplate">
                                    <Setter.Value>
                                        <DataTemplate>
                                            <views:ExportBackupView />
                                        </DataTemplate>
                                    </Setter.Value>
                                </Setter>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ContentControl.Style>
            </ContentControl>
        </Border>
    </Grid>
</Window>
